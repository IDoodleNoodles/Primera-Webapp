rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function canOwnerUpdateProfile(userId) {
      return isOwner(userId)
        && resource.data.get('role', 'patient') == 'patient'
        && request.resource.data.get('role', 'patient') == 'patient'
        && request.resource.data.get('assignedDoctorId', null) == resource.data.get('assignedDoctorId', null)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name', 'symptoms', 'middleName', 'username', 'email', 'authProviders',
          'lastLoginProvider', 'firstName', 'lastName', 'birthday', 'weightKg',
          'heightCm', 'lmpDate', 'eddDate', 'isFirstPregnancy', 'isCycleRegular',
          'shortestCycleDays', 'longestCycleDays', 'hasHadUltrasound',
          'positiveTestDate', 'scanDate', 'scanWeeks', 'scanDays', 'iceName',
          'iceRelationship', 'icePrimaryPhone', 'iceSecondaryPhone',
          'pregnancyHistories', 'onboardingCompleted', 'updatedAt', 'stepsGoal',
          'steps', 'heartRateBpm', 'sleepHours', 'sleepMinutes', 'spO2'
        ]);
    }

    function summaryFields() {
      return ['name', 'username', 'email', 'status', 'createdAt', 'lastActive', 'nameLower', 'emailLower'];
    }

    function validSummary() {
      return request.resource.data.keys().hasOnly(summaryFields())
        && request.resource.data.keys().hasAll(summaryFields())
        && request.resource.data.status in ['active', 'disabled'];
    }

    function validAudit() {
      return isSignedIn()
        && (isAdmin() || request.resource.data.action == 'unauthorized_access')
        && request.resource.data.keys().hasOnly([
          'actorUid', 'actorEmail', 'action', 'targetId', 'targetType',
          'result', 'details', 'timestamp'
        ])
        && request.resource.data.keys().hasAll([
          'actorUid', 'actorEmail', 'action', 'targetId', 'targetType',
          'result', 'details', 'timestamp'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.action in [
          'login', 'logout', 'list_view', 'search_view', 'edit', 'status_change',
          'password_reset', 'csv_export', 'unauthorized_access'
        ]
        && request.resource.data.actorEmail is string
        && request.resource.data.targetId is string
        && request.resource.data.targetType is string
        && request.resource.data.result is string
        && request.resource.data.details is string;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /accountSummaries/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && validSummary();
      allow update: if isOwner(userId) && validSummary()
        || isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'username', 'status', 'nameLower'
          ])
          && request.resource.data.status in ['active', 'disabled'];
      allow delete: if false;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.get('role', 'patient') == 'patient';
      allow read: if isOwner(userId);
      allow update: if canOwnerUpdateProfile(userId);
      allow delete: if false;
    }

    match /doctors/{doctorId} {
      allow read, write: if false;
    }

    match /doctors/{doctorId}/assignedPatients/{patientId} {
      allow read, write: if false;
    }

    match /assignments/{assignmentId} {
      allow read, write: if false;
    }

    match /alerts/{alertId} {
      allow read: if isOwner(resource.data.patientId);
      allow write: if false;
    }

    match /doctorLinkRequests/{requestId} {
      allow create: if isOwner(request.resource.data.patientId)
        && request.resource.data.status == 'pending';
      allow read: if isOwner(resource.data.patientId);
      allow update: if isOwner(resource.data.patientId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']);
      allow delete: if isOwner(resource.data.patientId);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if validAudit();
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /activity_logs/{logId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if false;
    }

    match /transcriptions/{transcriptionId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }

    match /goals/{goalId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read: if isOwner(resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /users/{userId}/smartwatchHealthRecords/{recordId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    match /users/{userId}/pregnancy_history/{historyId} {
      allow read, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
