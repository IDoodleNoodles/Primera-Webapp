{
  "name": "primera-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "npm run build && firebase deploy --only functions,firestore",
    "bootstrap": "npm run build && node lib/bootstrap.js",
    "set-role": "npm run build && node lib/setRole.js"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "firebase-tools": "^14.0.0",
    "typescript": "^5.9.0"
  }
}
